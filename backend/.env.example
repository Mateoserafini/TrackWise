PORT=5000
NODE_ENV=development
DATABASE_URL=postgresql://usuario:password@localhost:5432/trackwise
JWT_SECRET=super_secreto_para_firmar_tokens_jwt_32_chars_min
CLIENT_URL=http://localhost:3000

# Configuración de Correo Electrónico (Nodemailer)
# Para usar con Gmail:
# 1. Configura SMTP_SERVICE=gmail
# 2. Genera una "Contraseña de aplicación" en tu cuenta Google (Seguridad -> Verificación en 2 pasos -> Contraseñas de aplicación)
# 3. Coloca tu cuenta en SMTP_USER y la contraseña de 16 letras en SMTP_PASS
SMTP_SERVICE=gmail
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="TrackWise <noreply@trackwise.local>"
